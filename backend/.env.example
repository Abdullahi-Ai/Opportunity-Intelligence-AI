# Opportunity Intelligence AI - Environment Variables

# Application
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
# In production, SECRET_KEY must be >= 32 characters and distinct from default
SECRET_KEY=replace_with_a_secure_random_key_of_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# In production, ADMIN_REGISTRATION_SECRET must be >= 16 characters and distinct from default
ADMIN_REGISTRATION_SECRET=replace_with_a_secure_admin_registration_token_of_at_least_16_characters

# LLM Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# RAG & ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./data/chromadb
CHROMA_COLLECTION_NAME=kenya_opportunities
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Relational Database (PostgreSQL - SQLite fallback for local development)
DATABASE_URL=sqlite:///./data/app.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/opportunity_intelligence

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
